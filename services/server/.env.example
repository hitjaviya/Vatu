# Environment variables for server
# ===== ENVIRONMENT CONFIGURATION =====
# Set to 'development' or 'production'
NODE_ENV=development

# ===== SERVER CONFIGURATION =====
PORT=5000
SERVER_URL_DEV=http://localhost:5000
CLIENT_URL_DEV=http://localhost:5173
SERVER_URL_PROD=https://your-production-domain.com
CLIENT_URL_PROD=https://your-production-domain.com

# ===== MONGODB CONFIGURATION =====
MONGODB_URI_DEV=mongodb://localhost:27017/chat-app-dev
MONGODB_URI_PROD=mongodb://localhost:27017/chat-app-prod

# ===== JWT CONFIGURATION =====
JWT_SECRET_DEV=Osta3dh5FcRpj4oo7awxuPggASlVhgMs6Y5hy2mDbho
JWT_SECRET_PROD=prod-secret-key
JWT_EXPIRE=7d

# ===== FILE UPLOAD CONFIGURATION =====
MAX_FILE_SIZE=10485760
MAX_AVATAR_SIZE=2097152

# ============== CROS ORIGIN ==============
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============== AWS S3 CONFIGURATION ==============
# Used for uploading and sharing files between users
# Files are uploaded once to S3 and shared via presigned URLs
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
