{
    "name": "@chat-app/desktop",
    "version": "1.1.0",
    "description": "Vatu — Cross-platform desktop chat application",
    "main": "main.js",
    "homepage": "https://github.com/hitjaviya/Vatu",
    "license": "MIT",
    "author": {
        "name": "Hit Javiya",
        "email": "info@vatu.app"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
        "dev:prod": "concurrently \"npm run dev:react:prod\" \"npm run dev:electron\"",
        "dev:react": "vite",
        "dev:react:prod": "vite --mode production",
        "dev:electron": "LIBGL_ALWAYS_SOFTWARE=1 ELECTRON_OZONE_PLATFORM_HINT=auto wait-on http://localhost:5173 && electron . --no-sandbox",
        "build": "vite build --mode production && electron-builder",
        "build:prod": "vite build --mode production",
        "build:linux": "vite build --mode production && electron-builder --linux",
        "build:win": "vite build --mode production && electron-builder --win",
        "build:mac": "vite build --mode production && electron-builder --mac",
        "preview": "vite preview"
    },
    "build": {
        "appId": "app.vatu.desktop",
        "productName": "Vatu",
        "copyright": "Copyright © 2025 Hit Javiya. All rights reserved.",
        "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
        "electronVersion": "39.2.3",
        "asar": true,
        "compression": "maximum",
        "directories": {
            "output": "dist",
            "buildResources": "public/assets"
        },
        "files": [
            "build/**/*",
            "main.js",
            "preload.js",
            "public/**/*",
            "!**/*.map",
            "!**/node_modules/.cache/**"
        ],
        "extraMetadata": {
            "version": "1.1.0"
        },
        "publish": null,
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64", "ia32"]
                },
                {
                    "target": "portable",
                    "arch": ["x64"]
                }
            ],
            "icon": "public/assets/icon.png",
            "publisherName": "Hit Javiya",
            "legalTrademarks": "Vatu",
            "requestedExecutionLevel": "asInvoker",
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "signingHashAlgorithms": ["sha256"],
            "signDlls": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "installerIcon": "public/assets/icon.png",
            "uninstallerIcon": "public/assets/icon.png",
            "installerHeaderIcon": "public/assets/icon.png",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Vatu",
            "include": "build/installer.nsh",
            "script": "build/installer.nsh",
            "license": "LICENSE",
            "installerLanguages": ["English"],
            "displayLanguageSelector": false,
            "menuCategory": "Vatu",
            "deleteAppDataOnUninstall": false
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": ["x64", "arm64"]
                },
                {
                    "target": "zip",
                    "arch": ["x64", "arm64"]
                }
            ],
            "icon": "public/assets/icon.png",
            "bundleVersion": "1",
            "minimumSystemVersion": "10.13.0",
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "notarize": false
        },
        "dmg": {
            "title": "${productName} ${version}",
            "icon": "public/assets/icon.png",
            "background": null,
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                { "x": 130, "y": 220 },
                { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "deb",
                    "arch": ["x64", "arm64"]
                },
                {
                    "target": "AppImage",
                    "arch": ["x64"]
                },
                {
                    "target": "rpm",
                    "arch": ["x64"]
                }
            ],
            "icon": "public/assets/icon.png",
            "category": "Network",
            "maintainer": "Hit Javiya <info@vatu.app>",
            "vendor": "Hit Javiya",
            "description": "Vatu — Cross-platform chat application",
            "desktop": {
                "Name": "Vatu",
                "Comment": "Vatu Chat Application",
                "Categories": "Network;Chat;InstantMessaging;"
            },
            "artifactName": "${productName}-${version}-${arch}.${ext}"
        },
        "deb": {
            "depends": ["gconf2", "gconf-service", "libnotify4", "libappindicator1", "libxtst6", "libnss3"],
            "afterInstall": "build/postinst.sh",
            "afterRemove": "build/postrm.sh",
            "packageCategory": "net",
            "priority": "optional"
        },
        "appImage": {
            "artifactName": "${productName}-${version}-${arch}.AppImage"
        }
    },
    "dependencies": {
        "@chat-app/shared": "*"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "4.2.1",
        "concurrently": "^8.2.2",
        "electron": "39.2.3",
        "electron-builder": "^24.9.1",
        "vite": "^5.4.11",
        "wait-on": "^7.2.0"
    }
}
