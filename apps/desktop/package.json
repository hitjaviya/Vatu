{
    "name": "@chat-app/desktop",
    "version": "1.0.0",
    "description": "Desktop chat application built with Electron",
    "main": "main.js",
    "homepage": "https://github.com/hitjaviya/Vatu",
    "author": {
        "name": "ChatApp Team",
        "email": "info@chatapp.com"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
        "dev:prod": "concurrently \"npm run dev:react:prod\" \"npm run dev:electron\"",
        "dev:react": "vite",
        "dev:react:prod": "vite --mode production",
        "dev:electron": "LIBGL_ALWAYS_SOFTWARE=1 ELECTRON_OZONE_PLATFORM_HINT=auto wait-on http://localhost:5173 && electron . --no-sandbox",
        "build": "vite build --mode production && electron-builder",
        "build:prod": "vite build --mode production",
        "build:linux": "vite build --mode production && electron-builder --linux",
        "build:win": "vite build --mode production && electron-builder --win",
        "preview": "vite preview"
    },
    "build": {
        "appId": "com.chatapp.desktop",
        "productName": "ChatApp",
        "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
        "electronVersion": "39.2.3",
        "directories": {
            "output": "dist"
        },
        "files": [
            "build/**/*",
            "main.js",
            "preload.js",
            "public/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "assets/icon.png"
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icon.png"
        },
        "linux": {
            "target": "deb",
            "icon": "assets/icon.png",
            "category": "Network",
            "maintainer": "ChatApp Team <info@chatapp.com>"
        }
    },
    "dependencies": {
        "@chat-app/shared": "*"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "4.2.1",
        "concurrently": "^8.2.2",
        "electron": "39.2.3",
        "electron-builder": "^24.9.1",
        "vite": "^5.4.11",
        "wait-on": "^7.2.0"
    }
}
